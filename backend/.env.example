# ============================================================
# Google Stock NFT V3 — Backend Environment
# Copy to .env and fill in your values
# ============================================================

API_PORT=3002

# Render provides these as environment secrets — do NOT hardcode here
RPC_URL=
PRIVATE_KEY=

# Contract addresses (filled after deployment)
GOOGLE_STOCK_NFT=
PLATFORM_MANAGER=
STOCK_VAULT=
TREASURY_EOA=

# Frontend URL for CORS (e.g., https://your-app.onrender.com)
FRONTEND_URL=

# Whitelist deadline (ISO 8601 UTC — submissions rejected after this)
# Leave empty to keep open indefinitely
WL_DEADLINE=2026-08-08T19:00:00Z

# Whitelist target (display only)
TWITTER_TWEET_ID=
TWITTER_FOLLOW_ACCOUNT=
