# ============================================================
# Google Stock NFT V3 — Frontend Environment
# Copy to .env.local and fill in your values
# ============================================================

# === Network (testnet or mainnet) ===
NEXT_PUBLIC_NETWORK=mainnet
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_NETWORK_DISPLAY_NAME=Robinhood Chain

# Alchemy RPC for DAPP operations — required
NEXT_PUBLIC_MAINNET_RPC=

# Public RPC for wallet connection (add chain to wallet)
NEXT_PUBLIC_PUBLIC_RPC=https://rpc.mainnet.chain.robinhood.com

# === Explorer ===
NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://robinhoodchain.blockscout.com

# === Core Contract Addresses (fill after deployment) ===
NEXT_PUBLIC_NFT_ADDRESS=
NEXT_PUBLIC_PLATFORM_ADDRESS=
NEXT_PUBLIC_TREASURY_ADDRESS=
NEXT_PUBLIC_PILE_ADDRESS=

# === Token Addresses ===
NEXT_PUBLIC_GOOGL_ADDRESS=0x2e0847E8910a9732eB3fb1bb4b70a580ADAD4FE3
NEXT_PUBLIC_USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168

# === ERC-6551 ===
NEXT_PUBLIC_ERC6551_ACCOUNT_ADDRESS=0x8C92910D3230f51138571dba331D19150aFE6b11

# === WalletConnect ===
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# === Whitelist ===
NEXT_PUBLIC_TWITTER_TWEET_ID=
NEXT_PUBLIC_TWITTER_FOLLOW_ACCOUNT=

# === Treasury ===
NEXT_PUBLIC_TREASURY_EOA=
